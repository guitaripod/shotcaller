[Unit]
Description=IW4x UDP relay: players' packets in on UDP @PORT@, through the tunnel to the guest
After=network-online.target

[Service]
Type=simple
Environment=VM_GAME_PORT=@PORT@
ExecStart=@REPO@/ops/vm/vm.sh relay
Restart=always
RestartSec=5
Nice=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=@HIDDEN@
BindReadOnlyPaths=@REPO@
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=default.target
